# ==============================================================================
# SKY-LUX CRM - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3001
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=skylux
DB_USER=skylux
DB_PASSWORD=skylux_local_password

# Cache & Message Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication & RBAC
JWT_SECRET=skylux_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary app uploads only (images, documents, and chat attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=optrip

# Local demo seed only. Set a unique value before running `npm run seed`.
# The initial seed refuses to run when NODE_ENV=production.
SEED_DEFAULT_PASSWORD=
