# ==============================================================================
# SKY-LUX CRM - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3001
APP_VERSION=1.0.0
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 16)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=skylux
DB_USER=skylux
DB_PASSWORD=skylux_local_password

# Cache & Message Queue (Redis 7)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication & RBAC
JWT_SECRET=skylux_super_secret_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 / AWS S3 Storage (Documents & Attachments)
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=skylux-files
R2_PUBLIC_DOMAIN=https://files.skylux.vn

