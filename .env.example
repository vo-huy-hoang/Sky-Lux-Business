# ==============================================================================
# SKY-LUX CRM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_PORT=3001
APP_VERSION=latest
REGISTRY_OWNER=your-github-owner

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skylux
DB_USER=skylux
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Cache & Message Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secret
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# The browser uses same-origin /api through the aaPanel reverse proxy.
# No public API hostname is needed for the production frontend.

# Cloudflare R2 / S3 Object Storage
R2_ENDPOINT=REPLACE_WITH_R2_ENDPOINT
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
R2_BUCKET=skylux-files
R2_PUBLIC_DOMAIN=https://files.skylux.vn

# ==============================================================================
# 🔑 TÀI KHOẢN ĐĂNG NHẬP MẶC ĐỊNH (DEMO / SEED USERS)
# ==============================================================================
# 1. Super Admin / Ban Giám Đốc:
#    - Email:    admin@skylux.vn
#    - Mật khẩu: Admin@123456
#    - Vai trò:  SUPER_ADMIN, CEO_ADMIN (Toàn quyền quản trị hệ thống)
#
# 2. Giám Đốc Điều Hành (CEO):
#    - Email:    ceo@skylux.vn
#    - Mật khẩu: CeoAdmin@123456
#    - Vai trò:  CEO_ADMIN (Xem báo cáo, duyệt hồ sơ, xem KPI, doanh thu)
#
# 3. Chuyên Viên Kinh Doanh (Sales):
#    - Email:    sales@skylux.vn
#    - Mật khẩu: Sales@123456
#    - Vai trò:  SALES (Tạo & quản lý hồ sơ tour, báo giá, khách hàng)
#
# 4. Chuyên Viên Điều Hành (Operator):
#    - Email:    operator@skylux.vn
#    - Mật khẩu: Operator@123456
#    - Vai trò:  OPERATOR (Điều hành tour, kiểm tra dự toán, quản lý NCC)
#
# 5. Kế Toán (Accountant):
#    - Email:    accountant@skylux.vn
#    - Mật khẩu: Accountant@123456
