# ==============================================================================
# SKY-LUX CRM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_PORT=3001
APP_VERSION=latest
REGISTRY_OWNER=your-github-owner

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skylux
DB_USER=skylux
DB_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# Cache & Message Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secret
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS

# The browser uses same-origin /api through the aaPanel reverse proxy.
# No public API hostname is needed for the production frontend.

# Cloudinary app uploads only (images, documents, and chat attachments)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=optrip

# Database backups currently stay on the VPS; off-site backup can be configured later.
OFFSITE_BACKUP_REQUIRED=false
APP_DOMAIN=

# Local demo seed only. Set a unique value in a local, untracked .env before
# running `npm run seed`; the seed refuses to run when NODE_ENV=production.
SEED_DEFAULT_PASSWORD=
