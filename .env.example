# ==============================================================================
# SKY-LUX CRM - ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Application Environment
NODE_ENV=production
APP_PORT=3001
APP_VERSION=1.0.0

# Database (PostgreSQL 16)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=skylux
DB_USER=skylux
DB_PASSWORD=skylux_secure_password_2026

# Cache & Message Queue (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# JWT Secret
JWT_SECRET=skylux_super_secret_jwt_key_2026_change_in_production

# Cloudflare R2 / S3 Object Storage
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET=skylux-files
R2_PUBLIC_DOMAIN=https://files.skylux.vn

# ==============================================================================
# 🔑 TÀI KHOẢN ĐĂNG NHẬP MẶC ĐỊNH (DEMO / SEED USERS)
