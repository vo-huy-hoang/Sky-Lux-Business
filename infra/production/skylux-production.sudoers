# Install only after the root-owned wrapper has been reviewed and installed.
# The dedicated SSH account gets one wrapper and one full hexadecimal SHA.
Defaults!/usr/local/sbin/skylux-production-deploy env_reset
Defaults!/usr/local/sbin/skylux-production-deploy !setenv
skylux-deploy ALL=(root) NOPASSWD: /usr/local/sbin/skylux-production-deploy ^[[:xdigit:]]{40}$
