# ==============================================================================
# Git Line Endings Normalization (.gitattributes)
# Bảo đảm các file shell script và config luôn dùng LF chuẩn Linux
# ==============================================================================

# Bắt buộc các tệp shell script luôn dùng định dạng LF (tránh lỗi /bin/bash^M trên Linux)
*.sh text eol=lf

# Cấu hình Docker & Nginx luôn dùng LF
Dockerfile* text eol=lf
*.conf text eol=lf

# Cấu hình CI/CD & Compose
*.yml text eol=lf
*.yaml text eol=lf
