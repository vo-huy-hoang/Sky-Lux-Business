# ==========================================
# Sky-Lux CRM - Git Ignore Configuration
# ==========================================

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Environment & Secrets (Keep .env.example tracked)
.env
.env*.local
.env.development
.env.test
.env.production
backend/.env
frontend/.env
*.pem
*.key

# Exceptions to env files
!.env.example
!backend/.env.example
!frontend/.env.example

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build & Compilation Outputs
dist/
backend/dist/
build/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
next-env.d.ts

# Testing & Coverage
coverage/
*/coverage/
.nyc_output/

# Logs & Runtime
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Temporary & Output Directories
.temp/
.tmp/
outputs/

# IDE & Editor Configurations
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# VS Code (ignore workspace state, allow shared recommendations/config)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vercel & Deployment
.vercel/

.scratch/




# Gemini Codeassist ignore
GEMINI.md
skills-lock.json

# Other AI / tool configs
.agents/
.claude/
.claudecode/
.agentprotocol/

# OpenAI Codeassist plugin
.openai/plugins

# JetBrains AI Assistant
.idea/aider
